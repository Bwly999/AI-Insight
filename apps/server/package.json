{
  "name": "@ai-insight/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node --watch --import tsx/esm src/main.ts",
    "predev": "node ../../scripts/clear-port.mjs 4000",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx src/db/migrate.ts push",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-insight/agent": "workspace:*",
    "@ai-insight/datasources": "workspace:*",
    "@ai-insight/shared-types": "workspace:*",
    "@ai-insight/shared-ui": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@sinclair/typebox": "^0.34.14",
    "@vue/server-renderer": "^3.5.13",
    "better-sqlite3": "^12.2.0",
    "cron-parser": "^5.6.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "jose": "^6.2.3",
    "node-cron": "^3.0.3",
    "undici": "^6.21.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}

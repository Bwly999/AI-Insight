{
  "name": "@ai-insight/shared-ui",
  "version": "0.0.0",
  "private": true,
  "description": "编辑风设计系统：CSS 变量 token + 字体 + 工具类（用户端 + 管理端反相）",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/editorial.css": "./src/styles/editorial.css",
    "./styles/admin.css": "./src/styles/admin.css",
    "./tailwind-preset": {
      "types": "./src/tailwind-preset.ts",
      "default": "./src/tailwind-preset.ts"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@ai-insight/shared-config": "workspace:*",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}

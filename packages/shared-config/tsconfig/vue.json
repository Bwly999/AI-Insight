{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "AI Insight · Vue SPA (user / admin)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "useDefineForClassFields": true,
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"]
  }
}

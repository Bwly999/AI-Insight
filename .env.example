# =============================================================================
# AI Insight · 环境变量示例
# 复制为 .env 并填写真实值。敏感项一律来自环境变量，源码/schema 中无明文。
# =============================================================================

# ---- 数据库 ----
DATABASE_URL=mysql://root:aiinsight@localhost:3306/ai_insight
MYSQL_PASSWORD=aiinsight

# ---- 队列（BullMQ） ----
REDIS_URL=redis://localhost:6379

# ---- LLM（Vercel AI SDK → 内网 OpenAI 兼容地址） ----
# 留白：使用方填内网模型服务地址 / key / 模型名（见 doc/design-doc/14-留白与后续确认.md）
LLM_BASE_URL=http://internal-llm/v1
LLM_API_KEY=internal
LLM_MODEL=internal-model-name

# ---- JWT（外部登录服务签发，后端仅解包校验） ----
# 留白：使用方填签发方密钥/issuer/audience（见 doc/design-doc/14-留白与后续确认.md）
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# ---- 后端服务端口 ----
PORT=3000

# ---- 前端 API 反代前缀 ----
VITE_API_BASE=/api

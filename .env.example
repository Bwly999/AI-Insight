# AI-Insight 环境变量示例 — 复制为 .env.local 并填入真实值
# （.env.local 不入库；本仓库不含密钥）

# ===== LLM（内网 OpenAI 兼容）=====
# DeepSeek（OpenAI 兼容）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
AI_DEFAULT_MODEL=deepseek-v4-flash

# ===== 数据源 key =====
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Jina 可选（无 key 也能用，仅限流）
JINA_API_KEY=
# RSSHub 实例（可选）
RSSHUB_BASE=

# ===== 数据库 =====
DATABASE_URL=./data/insight.db

# ===== 鉴权（留空 → dev 降级，任意 token 通过）=====
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# ===== 运行 =====
PORT=3000
# 出站代理（可选）
PROXY_URL=
RUN_CONCURRENCY=3
RSS_POLL_CRON=*/30 * * * *

# ===== 前端 =====
VITE_API_BASE=http://localhost:3000

{
  "name": "@ai-insight/root",
  "version": "0.0.0",
  "private": true,
  "description": "AI Insight · The Insight Review — 内网 AI 洞察周刊平台",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:gen": "turbo run db:gen --filter=@ai-insight/server",
    "db:push": "turbo run db:push --filter=@ai-insight/server",
    "db:studio": "turbo run db:studio --filter=@ai-insight/server",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.10.1"
    }
  }
}
